<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.LoginController"
            prefWidth="1300" prefHeight="800"
            style="-fx-background-color: white;">

    <!-- LEFT SIDE - Illustration -->
    <left>
        <VBox alignment="CENTER" spacing="30"
              prefWidth="650"
              style="-fx-background-color: linear-gradient(to bottom right, #E8F0FE, #7BC6A4); -fx-padding: 60 40;">

            <ImageView fx:id="leftLogoImageView"
                       fitWidth="180"
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(31,60,136,0.3), 20, 0, 0, 5);"/>

            <Text text="MENSOS"
                  style="-fx-font-size: 56px; -fx-font-weight: 900; -fx-fill: #1F3C88; -fx-font-family: 'Poppins', 'Segoe UI';"/>

            <Text text="Votre plateforme de bien-être mental avec intelligence artificielle"
                  style="-fx-font-size: 20px; -fx-fill: #4A4A4A; -fx-font-family: 'Inter', 'Segoe UI';"
                  wrappingWidth="450"
                  textAlignment="CENTER"/>

            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(123,198,164,0.2); -fx-background-radius: 50; -fx-padding: 12 24;">
                <Label text="✨" style="-fx-font-size: 20px; -fx-text-fill: #7BC6A4;"/>
                <Label text="Calme · Confiance · Bien-être"
                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #7BC6A4;"/>
            </HBox>
        </VBox>
    </left>

    <!-- RIGHT SIDE - Login Form -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: white; -fx-background-color: white; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="20"
                  style="-fx-padding: 60 80; -fx-max-width: 500; -fx-background-color: white;">

                <!-- Header avec logo -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 20 0;">
                    <HBox alignment="CENTER" spacing="10">
                        <ImageView fx:id="rightLogoImageView"
                                   fitWidth="40"
                                   preserveRatio="true"/>
                        <Label text="MENSOS"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #1F3C88; -fx-font-family: 'Poppins';"/>
                    </HBox>

                    <Label text="Bienvenue sur MENSOS"
                           style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #4A4A4A;"/>

                    <Label text="Connectez-vous pour accéder à votre espace"
                           style="-fx-font-size: 15px; -fx-text-fill: #4A4A4A; -fx-opacity: 0.7;"/>
                </VBox>

                <!-- Formulaire de connexion -->
                <VBox spacing="25" style="-fx-padding: 10 0;">

                    <!-- Email -->
                    <VBox spacing="8">
                        <Label text="Email"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="emailField"
                                   promptText="votre@email.com"
                                   prefHeight="48"
                                   styleClass="modern-field"/>
                    </VBox>

                    <!-- Mot de passe -->
                    <VBox spacing="8">
                        <Label text="Mot de passe"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #4A4A4A;"/>
                        <PasswordField fx:id="motDePasseField"
                                       promptText="••••••••"
                                       prefHeight="48"
                                       styleClass="modern-field"/>
                    </VBox>

                    <!-- Status Label pour messages d'erreur -->
                    <Label fx:id="statusLabel"
                           styleClass="status-label"
                           managed="false" visible="false"/>

                    <!-- Login Button -->
                    <Button fx:id="loginButton"
                            text="Se connecter"
                            onAction="#handleLogin"
                            prefWidth="Infinity" prefHeight="56"
                            styleClass="btn-primary-login"/>

                    <!-- Lien vers création de compte -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Pas encore de compte ?"
                               style="-fx-font-size: 14px; -fx-text-fill: #4A4A4A;"/>
                        <Button fx:id="registerButton"
                                text="Créer un compte"
                                onAction="#handleRegister"
                                styleClass="btn-link"/>
                    </HBox>

                    <!-- Security message -->
                    <Label text="🔒 Vos données sont sécurisées et confidentielles"
                           style="-fx-font-size: 12px; -fx-text-fill: #4A4A4A; -fx-opacity: 0.6; -fx-padding: 20 0 0 0;"
                           alignment="CENTER"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>