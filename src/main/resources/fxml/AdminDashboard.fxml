<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminDashboardController"
            prefWidth="1400" prefHeight="900"
            style="-fx-background-color: #F5F7FA;">

    <!-- ========== HEADER ========== -->
    <top>
        <VBox style="-fx-background-color: #1F3C88; -fx-border-color: #E5E9F0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 40;">

                <!-- Logo et titre -->
                <HBox spacing="15" alignment="CENTER">
                    <Label text="🧠" style="-fx-font-size: 32px; -fx-text-fill: #1F3C88;"/>
                    <Label text="MENSOS" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label text="•" style="-fx-font-size: 24px; -fx-text-fill: #7BC6A4;"/>
                    <Label text="Administration" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: white;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Date et déconnexion -->
                <Label fx:id="welcomeDateLabel" style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"/>
                <Button fx:id="logoutButton"
                        text="🚪 Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #FEF5F5; -fx-text-fill: #E74C3C; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 30; -fx-padding: 10 25; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ========== CENTER ========== -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 30 40;">

                <!-- ========== INFOS ADMIN ========== -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox>
                        <Label fx:id="adminNameLabel" text="Admin"
                               style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1F3C88;"/>
                        <Label fx:id="adminEmailLabel" text="admin@mensos.com"
                               style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"/>
                    </VBox>
                    <Label fx:id="adminRoleLabel" text="Administrateur"
                           style="-fx-background-color: #1F3C88; -fx-text-fill: white; -fx-padding: 5 20; -fx-background-radius: 20; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Rafraîchir" onAction="#refreshData"
                            style="-fx-background-color: #E8F0FE; -fx-text-fill: #1F3C88; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 30; -fx-padding: 10 25; -fx-cursor: hand;"/>
                </HBox>

                <Separator style="-fx-background-color: #E8F0FE;"/>

                <!-- ========== STATISTIQUES ========== -->
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="16.66"/>
                        <ColumnConstraints percentWidth="16.66"/>
                        <ColumnConstraints percentWidth="16.66"/>
                        <ColumnConstraints percentWidth="16.66"/>
                        <ColumnConstraints percentWidth="16.66"/>
                        <ColumnConstraints percentWidth="16.66"/>
                    </columnConstraints>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 0);"
                          GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="👥" style="-fx-font-size: 24px;"/>
                        <Label text="Total" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1F3C88;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;"
                          GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="✅" style="-fx-font-size: 24px;"/>
                        <Label text="Actifs" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="activeUsersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #27AE60;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;"
                          GridPane.rowIndex="0" GridPane.columnIndex="2">
                        <Label text="⛔" style="-fx-font-size: 24px;"/>
                        <Label text="Inactifs" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="inactiveUsersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #E74C3C;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;"
                          GridPane.rowIndex="0" GridPane.columnIndex="3">
                        <Label text="👤" style="-fx-font-size: 24px;"/>
                        <Label text="Patients" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="patientsCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #3498DB;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;"
                          GridPane.rowIndex="0" GridPane.columnIndex="4">
                        <Label text="🧠" style="-fx-font-size: 24px;"/>
                        <Label text="Psychiatres" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="psyCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #9B59B6;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20;"
                          GridPane.rowIndex="0" GridPane.columnIndex="5">
                        <Label text="🌿" style="-fx-font-size: 24px;"/>
                        <Label text="Coachs" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;"/>
                        <Label fx:id="coachCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #7BC6A4;"/>
                    </VBox>
                </GridPane>

                <!-- ========== TAB PANEL ========== -->
                <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white; -fx-background-radius: 20;">

                    <!-- ========== ONGLET UTILISATEURS ========== -->
                    <Tab text="📋 Gestion des utilisateurs">
                        <VBox spacing="20" style="-fx-padding: 20;">

                            <!-- Filtres -->
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <Label text="Filtres:" style="-fx-font-weight: 600;"/>
                                <ComboBox fx:id="roleFilterCombo" prefWidth="150" promptText="Rôle"/>
                                <ComboBox fx:id="statusFilterCombo" prefWidth="150" promptText="Statut"/>
                                <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="250"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="➕ Ajouter un utilisateur" onAction="#ajouterUtilisateur"
                                        style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: 600; -fx-background-radius: 30; -fx-padding: 10 20; -fx-cursor: hand;"/>
                            </HBox>

                            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                <columns>
                                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="120"/>
                                    <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="120"/>
                                    <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                                    <TableColumn fx:id="roleCol" text="Rôle" prefWidth="120"/>
                                    <TableColumn fx:id="statusCol" text="Statut" prefWidth="80"/>
                                    <TableColumn fx:id="dateCol" text="Inscription" prefWidth="100"/>
                                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="250"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- ========== ONGLET HISTORIQUE CONNEXIONS ========== -->
                    <Tab text="🔐 Historique des connexions">
                        <VBox spacing="20" style="-fx-padding: 20;">
                            <HBox alignment="CENTER_RIGHT">
                                <Button text="📥 Exporter CSV" onAction="#exportLogs"
                                        style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: 600; -fx-background-radius: 30; -fx-padding: 10 20; -fx-cursor: hand;"/>
                            </HBox>
                            <TableView fx:id="logsTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                <columns>
                                    <TableColumn fx:id="logIdCol" text="ID" prefWidth="50"/>
                                    <TableColumn fx:id="logUserCol" text="Utilisateur" prefWidth="150"/>
                                    <TableColumn fx:id="logEmailCol" text="Email" prefWidth="200"/>
                                    <TableColumn fx:id="logDateCol" text="Date" prefWidth="180"/>
                                    <TableColumn fx:id="logIpCol" text="IP" prefWidth="120"/>
                                    <TableColumn fx:id="logStatusCol" text="Statut" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- ========== ONGLET CV EN ATTENTE ========== -->
                    <Tab text="📄 CV en attente">
                        <VBox spacing="20" style="-fx-padding: 20;">
                            <Label fx:id="pendingCvCountLabel" text="0 CV en attente de validation"
                                   style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1F3C88;"/>
                            <TableView fx:id="pendingCvTable" VBox.vgrow="ALWAYS" prefHeight="400">
                                <columns>
                                    <TableColumn fx:id="cvIdCol" text="ID" prefWidth="50"/>
                                    <TableColumn fx:id="cvUserCol" text="Utilisateur" prefWidth="200"/>
                                    <TableColumn fx:id="cvNomCol" text="Fichier" prefWidth="250"/>
                                    <TableColumn fx:id="cvDateCol" text="Date" prefWidth="100"/>
                                    <TableColumn fx:id="cvTailleCol" text="Taille" prefWidth="80"/>
                                    <TableColumn fx:id="cvActionsCol" text="Actions" prefWidth="250"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>